# 预置直播源（M3U 格式，实测可用，含 CCTV/卫视全套 500+ 频道）
DEFAULT_LIVE_SOURCES=[{"name":"ZBDS-IPTV4央视卫视","url":"https://live.zbds.top/tv/iptv4.m3u"}]
